# ─────────────────────────────────────────────
# CreatorOS — Environment Configuration
# ─────────────────────────────────────────────

# Database
DATABASE_URL="postgres://creatoros:changeme@localhost:5432/creatoros"
REDIS_URL="redis://:changeme@localhost:6379"

# Auth
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-another-random-string-at-least-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Encryption (32-byte hex for AES-256-GCM)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Google OAuth (YouTube API)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3001/api/v1/auth/youtube/callback"

# AI Providers (optional — set at least one)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_AI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# MinIO (S3-compatible storage)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="creatoros"
MINIO_SECRET_KEY="changeme"
MINIO_BUCKET="creatoros-assets"

# App
NODE_ENV="development"
LOG_LEVEL="info"
CORS_ORIGIN="http://localhost:3000"
DASHBOARD_URL="http://localhost:3000"
API_URL="http://localhost:3001"

# YouTube Data API
YOUTUBE_API_KEY=""
